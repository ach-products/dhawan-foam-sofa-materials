# Copy to .env.local (gitignored) and fill in real values for local development.
# Server-only secrets — never prefix with VITE_, or they ship to the browser bundle.
BLACKSMS_API_KEY=
# Your BlackSMS sender ID for the /sms "OTP Send API" (check your BlackSMS dashboard).
BLACKSMS_SENDER_ID=
# Any random string — signs the OTP challenge token. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SIGNING_SECRET=
